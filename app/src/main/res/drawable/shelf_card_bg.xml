<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- צל עדין -->
    <item>
        <shape>
            <solid android:color="#22000000"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>

    <!-- המסגרת הלבנה -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">

        <shape>
            <solid android:color="#FFFFFF"/>
            <corners android:radius="16dp"/>
            <stroke
                android:width="1dp"
                android:color="#EDEDED"/>
        </shape>

    </item>

</layer-list>
