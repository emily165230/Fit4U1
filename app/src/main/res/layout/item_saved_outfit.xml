<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="22dp"
    app:cardElevation="6dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/tvOutfitDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026-01-21"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#FF5AA5"
            android:paddingBottom="10dp" />

        <!-- 2x2 Grid (stable) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:orientation="vertical">

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgGrid1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/placeholder_item"
                    android:background="@drawable/item_placeholder_bg" />

                <ImageView
                    android:id="@+id/imgGrid2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/placeholder_item"
                    android:background="@drawable/item_placeholder_bg" />
            </LinearLayout>

            <!-- Space between rows -->
            <View
                android:layout_width="match_parent"
                android:layout_height="12dp" />

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgGrid3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/placeholder_item"
                    android:background="@drawable/item_placeholder_bg" />

                <ImageView
                    android:id="@+id/imgGrid4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/placeholder_item"
                    android:background="@drawable/item_placeholder_bg" />
            </LinearLayout>

        </LinearLayout>


    </LinearLayout>
</androidx.cardview.widget.CardView>
