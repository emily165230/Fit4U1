<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/pink_background"
        android:scaleType="centerCrop" />

    <!-- Soft overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55FFFFFF" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <!-- Back -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/back_circle"
            android:src="@drawable/ic_back_arrow"
            android:contentDescription="Back"
            android:padding="10dp"
            android:elevation="6dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_margin="8dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today’s Outfit"
            android:textStyle="bold"
            android:textSize="28sp"
            android:letterSpacing="0.05"
            android:textColor="#FF5AA5"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="6dp" />

        <!-- Outfit card -->
        <LinearLayout
            android:id="@+id/cardOutfit"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:background="@drawable/outfit_card_bg"
            android:padding="14dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bottomActions"
            android:layout_marginTop="14dp">

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <!-- TOPS -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/imgTops"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:src="@drawable/placeholder_item"
                        android:scaleType="centerCrop"
                        android:background="@drawable/item_placeholder_bg" />

                    <Button
                        android:id="@+id/btnChangeTops"
                        style="@style/FitPinkButton"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Change Tops"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- PANTS -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/imgPants"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:src="@drawable/placeholder_item"
                        android:scaleType="centerCrop"
                        android:background="@drawable/item_placeholder_bg" />

                    <Button
                        android:id="@+id/btnChangePants"
                        style="@style/FitPinkButton"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Change Pants"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <!-- SHOES -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/imgShoes"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:src="@drawable/placeholder_item"
                        android:scaleType="centerCrop"
                        android:background="@drawable/item_placeholder_bg" />

                    <Button
                        android:id="@+id/btnChangeShoes"
                        style="@style/FitPinkButton"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Change Shoes"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- JACKET -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/imgJacket"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:src="@drawable/placeholder_item"
                        android:scaleType="centerCrop"
                        android:background="@drawable/item_placeholder_bg" />

                    <Button
                        android:id="@+id/btnChangeJacket"
                        style="@style/FitPinkButton"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="Change Jacket"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom actions -->
        <LinearLayout
            android:id="@+id/bottomActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btnShuffle"
                style="@style/FitPinkButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Shuffle" />

            <Button
                android:id="@+id/btnSave"
                style="@style/FitPinkOutlineButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Save Outfit" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
