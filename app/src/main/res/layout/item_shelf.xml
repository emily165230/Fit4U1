<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="18dp">

    <!-- Category title with OUTLINE (2 TextViews stacked) -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp">

        <!-- outline -->
        <TextView
            android:id="@+id/tvShelfTitleOutline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jackets"
            android:textStyle="bold"
            android:textSize="20sp"
            android:letterSpacing="0.03"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/baloo2"
            android:translationX="1dp"
            android:translationY="1dp" />

        <!-- fill -->
        <TextView
            android:id="@+id/tvShelfTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jackets"
            android:textStyle="bold"
            android:textSize="20sp"
            android:letterSpacing="0.03"
            android:textColor="#FF8FC7"
            android:fontFamily="@font/baloo2" />
    </FrameLayout>

    <!-- Shelf card with thin white border + shadow -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:elevation="8dp"
        app:cardCornerRadius="18dp"
        app:cardUseCompatPadding="true"
        app:cardPreventCornerOverlap="true"
        app:cardBackgroundColor="#FFFFFF">

        <!-- inner rounded container so the shelf image keeps rounded corners -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            android:clipToOutline="true"
            android:background="@drawable/shelf_card_bg_rounded">

            <!-- Shelf image -->
            <ImageView
                android:id="@+id/imgShelfBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/shelf_bg"
                android:scaleType="centerCrop" />

            <!-- Items on the shelf (moved up a bit, more centered) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvItems"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="14dp"
                android:clipToPadding="false" />

        </FrameLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
