<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="FitPinkButton">
        <item name="android:layout_height">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:background">@drawable/pink_filled_button_bg</item>

        <!-- kill tint -->
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
    </style>

    <style name="FitPinkOutlineButton">
        <item name="android:layout_height">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FF5AA5</item>
        <item name="android:background">@drawable/pink_outline_button_bg</item>

        <!-- kill tint -->
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
    </style>



</resources>
